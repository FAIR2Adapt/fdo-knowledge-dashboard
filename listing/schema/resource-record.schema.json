{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://w3id.org/fair2adapt/fdo-knowledge-dashboard/record/1",
 "title": "ResourceRecord, schema fdo-knowledge-dashboard/record/1",
 "description": "What the site shows for one member of the collection. Every value comes from the object through fdo-consume; a value the object does not state is null or empty. Relations carry is_pid (the id has a scheme) and key (set when the related object is a member of the same collection).",
 "type": "object",
 "required": [
  "schema",
  "pid",
  "key",
  "title",
  "description",
  "resource_type",
  "keywords",
  "authors",
  "date",
  "year",
  "licence",
  "access",
  "profiles",
  "status",
  "claims",
  "datasets",
  "related",
  "files",
  "source"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "fdo-knowledge-dashboard/record/1"
  },
  "pid": {
   "type": "string",
   "minLength": 1
  },
  "key": {
   "type": "string",
   "pattern": "^[0-9a-f]{16}$"
  },
  "title": {
   "type": [
    "string",
    "null"
   ]
  },
  "description": {
   "type": [
    "string",
    "null"
   ]
  },
  "resource_type": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "keywords": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "authors": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "date": {
   "type": [
    "string",
    "null"
   ]
  },
  "year": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9]{4}$"
  },
  "licence": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "iri",
    "label"
   ],
   "properties": {
    "iri": {
     "type": "string"
    },
    "label": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "access": {
   "$ref": "#/$defs/access"
  },
  "profiles": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "iri",
     "label"
    ],
    "properties": {
     "iri": {
      "type": "string"
     },
     "label": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "status": {
   "type": [
    "string",
    "null"
   ]
  },
  "claims": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "kind",
     "text",
     "concepts",
     "asserted_in"
    ],
    "properties": {
     "kind": {
      "enum": [
       "claim",
       "nanopublication",
       "linked_nanopublication",
       "statement"
      ]
     },
     "text": {
      "type": [
       "string",
       "null"
      ]
     },
     "asserted_in": {
      "type": [
       "object",
       "null"
      ],
      "required": [
       "pid",
       "is_pid",
       "title",
       "key",
       "status"
      ],
      "properties": {
       "pid": {
        "type": "string"
       },
       "is_pid": {
        "type": "boolean"
       },
       "title": {
        "type": [
         "string",
         "null"
        ]
       },
       "key": {
        "type": [
         "string",
         "null"
        ]
       },
       "status": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     "concepts": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "note": {
      "type": [
       "string",
       "null"
      ],
      "description": "a visible caveat on how this claim was found (for example a nanopublication registered under another type)"
     },
     "inferred": {
      "type": "boolean",
      "description": "true when the kind was inferred by this consumer (linked_nanopublication), not declared by the record"
     },
     "asserted_by": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "iri",
        "label"
       ],
       "properties": {
        "iri": {
         "type": "string"
        },
        "label": {
         "type": "string"
        }
       }
      },
      "description": "the authors the nanopublication names (schema:author); the label is the IRI's tail when no name is delivered"
     },
     "text_kind": {
      "enum": [
       "assertion",
       "name"
      ],
      "description": "assertion: the text is the claim or statement; name: the text is the registered name of a part (nanopublication, linked_nanopublication)"
     },
     "text_cut": {
      "type": "boolean",
      "description": "true when a name ends with an ellipsis in the record"
     }
    }
   }
  },
  "datasets": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "pid",
     "name",
     "access",
     "extent",
     "variables",
     "files"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "pid": {
      "type": [
       "string",
       "null"
      ]
     },
     "name": {
      "type": [
       "string",
       "null"
      ]
     },
     "access": {
      "$ref": "#/$defs/access"
     },
     "variables": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "name",
        "unit",
        "unit_code",
        "description"
       ]
      }
     },
     "files": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/file"
      }
     },
     "extent": {
      "type": "object",
      "required": [
       "box"
      ],
      "properties": {
       "box": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    }
   }
  },
  "related": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "pid",
     "is_pid",
     "title",
     "key",
     "profile",
     "readable"
    ],
    "properties": {
     "pid": {
      "type": "string"
     },
     "is_pid": {
      "type": "boolean"
     },
     "title": {
      "type": [
       "string",
       "null"
      ]
     },
     "key": {
      "type": [
       "string",
       "null"
      ]
     },
     "profile": {
      "type": [
       "string",
       "null"
      ]
     },
     "readable": {
      "type": "boolean"
     }
    }
   }
  },
  "files": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/file"
   }
  },
  "source": {
   "type": "object",
   "required": [
    "reader",
    "read_at",
    "kind",
    "usable",
    "explanation",
    "record",
    "claims"
   ],
   "properties": {
    "reader": {
     "type": "string"
    },
    "read_at": {
     "type": "string"
    },
    "usable": {
     "type": "boolean"
    },
    "explanation": {
     "type": [
      "string",
      "null"
     ]
    },
    "record": {
     "$ref": "#/$defs/console"
    },
    "claims": {
     "$ref": "#/$defs/console"
    },
    "kind": {
     "enum": [
      "recorded",
      "live"
     ]
    }
   }
  },
  "author_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "identifier": {
   "type": [
    "string",
    "null"
   ]
  },
  "based_on": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "pid",
     "is_pid",
     "title",
     "key"
    ],
    "properties": {
     "pid": {
      "type": "string"
     },
     "is_pid": {
      "type": "boolean"
     },
     "title": {
      "type": [
       "string",
       "null"
      ]
     },
     "key": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "not_read": {
   "type": "array",
   "items": {
    "enum": [
     "authors",
     "date",
     "licence",
     "access",
     "type",
     "keywords",
     "description"
    ]
   },
   "description": "record fields the reader could not read because the selected map defines no term for them; distinct from a value the object does not state (null or empty)"
  }
 },
 "$defs": {
  "access": {
   "type": "object",
   "required": [
    "state",
    "conditions"
   ],
   "properties": {
    "state": {
     "enum": [
      "open",
      "restricted",
      "unknown"
     ]
    },
    "conditions": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "file": {
   "type": "object",
   "required": [
    "path",
    "media_type",
    "access",
    "url"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "media_type": {
     "type": [
      "string",
      "null"
     ]
    },
    "access": {
     "enum": [
      "open",
      "restricted",
      "unknown"
     ]
    },
    "url": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "console": {
   "type": "object",
   "required": [
    "contract",
    "usable",
    "outcome",
    "statuses",
    "map",
    "overlay",
    "validator",
    "diagnostics",
    "why",
    "notes",
    "unknown_contexts",
    "unknown_terms",
    "located"
   ],
   "properties": {
    "contract": {
     "type": [
      "string",
      "null"
     ]
    },
    "usable": {
     "type": "boolean"
    },
    "outcome": {
     "type": "string"
    },
    "stopped": {
     "type": [
      "string",
      "null"
     ]
    },
    "error": {
     "type": [
      "object",
      "null"
     ]
    },
    "statuses": {
     "type": "object"
    },
    "map": {
     "type": [
      "string",
      "null"
     ]
    },
    "overlay": {
     "type": [
      "string",
      "null"
     ]
    },
    "validator": {
     "type": "object",
     "required": [
      "ran",
      "reason",
      "note"
     ]
    },
    "diagnostics": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "stage",
       "code",
       "status",
       "message"
      ]
     }
    },
    "why": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "notes": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "step",
       "code",
       "terms"
      ]
     }
    },
    "unknown_contexts": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "unknown_terms": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "located": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  }
 }
}
